# Template for app/.env — copy to .env and fill in real values.
# Loaded by main.js at startup. Do not commit the real .env.

# PostHog telemetry
POSTHOG_API_KEY=

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook Calendar OAuth2 (PKCE public client — no client secret)
OUTLOOK_CLIENT_ID=
